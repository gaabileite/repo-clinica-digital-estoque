# Ambiente
NODE_ENV=development

# API do módulo (porta reservada ao Estoque em docs/module-catalog.md do shell)
API_PORT=3002
# API_BASE_URL é derivada como http://localhost:${API_PORT}; defina só se precisar de outra.
# API_BASE_URL=https://meu-dominio.com

# Frontend do módulo (remote suppliesMfe)
WEB_PORT=5175
# WEB_BASE_URL segue a mesma lógica.
# WEB_BASE_URL=https://meu-dominio.com

# Origem do shell que hospeda o módulo (CORS)
SHELL_BASE_URL=http://localhost:5173

# PostgreSQL local via Docker Compose (porta reservada: 5434)
POSTGRES_DB=estoque
POSTGRES_USER=estoque
POSTGRES_PASSWORD=estoque_dev_password_change_me
POSTGRES_PORT=5434

# Prisma / conexão com o banco do módulo
DATABASE_URL=postgresql://estoque:estoque_dev_password_change_me@localhost:5434/estoque?schema=public

# Autenticação de desenvolvimento (NUNCA em produção).
# Lê o perfil dos cabeçalhos x-dev-user, x-dev-profile e x-dev-clinics. Em uso real, a identidade vem do token do IAM (docs/architecture.md).
DEV_AUTH_ENABLED=true
